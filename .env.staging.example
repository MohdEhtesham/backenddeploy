# ─────────────────────────────────────────────────────────────────────────────
# Aabroo API — STAGING environment (e.g. the current Render test deployment)
# Set these in the hosting dashboard; do not commit a filled-in copy.
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=production
APP_ENV=staging
# PUBLIC_API_URL defaults to Render's RENDER_EXTERNAL_URL
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/aabroo-staging?retryWrites=true&w=majority
JWT_SECRET=<openssl rand -hex 32>
FILE_URL_SECRET=<openssl rand -hex 32>
CORS_ORIGINS=https://admin-staging.abroo.app
ACCESS_TOKEN_TTL=1h

# Demo OTP stays available on staging until an SMS provider is configured.
OTP_MODE=fixed

CLOUDINARY_CLOUD_NAME=<cloud>
CLOUDINARY_API_KEY=<key>
CLOUDINARY_API_SECRET=<secret>
STORAGE_DRIVER=cloudinary

# Razorpay TEST keys (rzp_test_…)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

PUSH_PROVIDER=console
SMS_PROVIDER=console
EMAIL_PROVIDER=console
WHATSAPP_PROVIDER=console

JOBS_ENABLED=true
CRON_SECRET=<openssl rand -hex 24>
API_DOCS_ENABLED=true
