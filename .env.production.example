# ─────────────────────────────────────────────────────────────────────────────
# Aabroo API — PRODUCTION environment
# The server REFUSES TO BOOT with APP_ENV=production when:
#   JWT_SECRET < 32 chars, OTP_MODE=fixed, STORAGE_DRIVER=local,
#   or FILE_URL_SECRET is missing.
# Store every value in the hosting provider's secret manager.
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=production
APP_ENV=production
PUBLIC_API_URL=https://api.abroo.app
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/aabroo?retryWrites=true&w=majority
JWT_SECRET=<openssl rand -hex 32>
FILE_URL_SECRET=<openssl rand -hex 32>
JWT_EXPIRES_IN=30d
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS=https://admin.abroo.app
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=20

OTP_MODE=random
OTP_LENGTH=6
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=<key>
MSG91_TEMPLATE_ID=<dlt-template>
MSG91_OTP_TEMPLATE_ID=<dlt-otp-template>

CLOUDINARY_CLOUD_NAME=<cloud>
CLOUDINARY_API_KEY=<key>
CLOUDINARY_API_SECRET=<secret>
STORAGE_DRIVER=cloudinary
SIGNED_URL_TTL_SECONDS=300

# Razorpay LIVE keys (rzp_live_…)
RAZORPAY_KEY_ID=<key>
RAZORPAY_KEY_SECRET=<secret>
RAZORPAY_WEBHOOK_SECRET=<webhook-secret>

PUSH_PROVIDER=fcm
FCM_PROJECT_ID=<project>
FCM_CLIENT_EMAIL=<service-account-email>
FCM_PRIVATE_KEY=<-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n>
EMAIL_PROVIDER=resend
EMAIL_API_KEY=<key>
EMAIL_FROM=Aabroo <no-reply@abroo.app>
WHATSAPP_PROVIDER=meta
WHATSAPP_TOKEN=<token>
WHATSAPP_PHONE_NUMBER_ID=<id>

JOBS_ENABLED=true
JOBS_INTERVAL_MINUTES=30
CRON_SECRET=<openssl rand -hex 24>

APP_LINK_HOSTS=abroo.app,www.abroo.app
ANDROID_SHA256_CERT_FINGERPRINTS=<AA:BB:...>
IOS_APP_IDS=<TEAMID>.com.aoccrmconnect
API_DOCS_ENABLED=false
