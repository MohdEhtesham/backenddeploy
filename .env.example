# ─────────────────────────────────────────────────────────────────────────────
# Aabroo API — DEVELOPMENT environment
# Copy to backend/.env and fill in. Never commit real secrets.
# Staging / production templates: .env.staging.example, .env.production.example
# ─────────────────────────────────────────────────────────────────────────────

# Server
NODE_ENV=development
APP_ENV=development
PORT=4000
# Public base URL of this API (payment return URLs, signed file links).
# On Render this defaults to RENDER_EXTERNAL_URL automatically.
PUBLIC_API_URL=http://localhost:4000

# MongoDB (Atlas free tier works: https://www.mongodb.com/cloud/atlas)
# Either env name works: MONGODB_URI or MONGO_URI. Use a replica set
# (Atlas always is; docker-compose starts one) so transactions are enabled.
MONGODB_URI=mongodb://localhost:27017/aabroo?replicaSet=rs0

# JWT — use a long random string (>= 32 chars): openssl rand -hex 32
JWT_SECRET=replace-me-with-a-long-random-string
# Lifetime of tokens for legacy clients (older app builds, admin web)
JWT_EXPIRES_IN=30d
# Clients sending "X-Auth-Mode: refresh" get short access tokens + refresh tokens
ACCESS_TOKEN_TTL=1h
REFRESH_TOKEN_TTL_DAYS=30
SESSION_MAX_AGE_DAYS=90

# CORS — comma separated origins. Use * for everything (dev only)
CORS_ORIGINS=*

# Rate limits (requests per 15 min per IP)
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=30

# OTP — fixed = demo code (dev/staging only), random = real SMS codes
OTP_MODE=fixed
OTP_FIXED_CODE=1234
OTP_LENGTH=4
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_SENDS_PER_HOUR=5

# Cloudinary (https://console.cloudinary.com/) — OPTIONAL in development
# Public images (listings, property photos) + private KYC documents when
# STORAGE_DRIVER=cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Private document storage: local (dev only) | cloudinary
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage/private
FILE_URL_SECRET=replace-me-another-long-random-string
SIGNED_URL_TTL_SECONDS=600
MAX_UPLOAD_MB=8

# Payments — Razorpay (https://dashboard.razorpay.com → Settings → API keys / Webhooks)
# Webhook URL: <PUBLIC_API_URL>/api/webhooks/razorpay
# Events: payment_link.paid, payment_link.expired, payment_link.cancelled, refund.processed, refund.failed
# Leave blank to disable online payments (cash/UPI/bank recording still works).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_LINK_EXPIRY_MINUTES=1440

# Notification channels: console (logs) | real providers
PUSH_PROVIDER=console
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# Private key from the Firebase service account JSON (keep the \n escapes)
FCM_PRIVATE_KEY=
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_OTP_TEMPLATE_ID=
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=Aabroo <no-reply@abroo.app>
WHATSAPP_PROVIDER=console
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# SaaS defaults (seed values — the super admin edits them live)
SAAS_TRIAL_DAYS=14
SAAS_TRIAL_PLAN=BUSINESS
SAAS_GRACE_DAYS=7
# EXPIRE (read-only until a plan is chosen) | DOWNGRADE_TO_FREE
SAAS_TRIAL_EXPIRY_ACTION=EXPIRE

# Marketplace seller plans: true enforces per-plan listing limits (free = 1).
# false (default for now) lets every seller post unlimited listings.
LISTING_QUOTA_ENFORCED=false

# Background jobs (monthly invoices, overdue, reminders, subscriptions)
JOBS_ENABLED=true
JOBS_INTERVAL_MINUTES=60
# Enables POST /api/internal/jobs/:name with header X-Cron-Secret
CRON_SECRET=

# Deep links / universal links
APP_SCHEME=abroo
APP_LINK_HOSTS=abroo.app,www.abroo.app
ANDROID_PACKAGE=com.aoccrmconnect
# Comma separated SHA-256 signing cert fingerprints (Play Console → App integrity)
ANDROID_SHA256_CERT_FINGERPRINTS=
# Comma separated TEAMID.bundle-id values
IOS_APP_IDS=

API_DOCS_ENABLED=true
ANALYTICS_RETENTION_DAYS=180
DEFAULT_TIMEZONE=Asia/Kolkata
